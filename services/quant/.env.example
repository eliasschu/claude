# Bot-Dienst (api, bot-worker, scheduler). Kopieren nach .env und anpassen.
# Betriebsart: research | paper   ('live' ist bis zur rechtlichen Pruefung gesperrt)
BOT_MODE=paper
# Safe Production Test Mode: echte Daten, KEINE echten Orders. LIVE_TRADING=true bricht den Start ab.
LIVE_DATA=true
LIVE_TRADING=false
SHADOW_EXECUTION=true
# Passwort identisch mit POSTGRES_PASSWORD in der Compose-.env
DATABASE_URL=postgresql://quant:PASSWORT@postgres:5432/quant
REDIS_URL=redis://redis:6379/0
# Pflicht fuer die API; das Next.js-Backend sendet es als Bearer-Token. Lang und zufaellig waehlen.
BOT_API_TOKEN=
CRYPTO_CYCLE_SECONDS=60
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
EQUITY_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD
PAPER_ACCOUNT_ID=paper-main
PAPER_STARTING_CASH=100000
# SEC verlangt Name + E-Mail im User-Agent
SEC_EDGAR_USER_AGENT=
# FRED/ALFRED (kostenloser Schluessel: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=
# true, sobald der ws-ingestor laeuft (Health meldet sonst nur "nicht konfiguriert")
EXPECT_WEBSOCKETS=false
