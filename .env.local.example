# Kopieren nach .env.local. Diese Datei gehoert NICHT ins Repository.
# Alle Schluessel sind rein serverseitig und erscheinen nie im Browser.

# --- SEC EDGAR (kostenlos, kein Schluessel; Kontaktangabe ist Pflicht) -------
SEC_EDGAR_USER_AGENT="Finanzwelt Elias Schuepany Elias.schuepany@gmail.com"

# --- CoinGecko (kostenloser Demo-Tarif, Namensnennung Pflicht) --------------
# https://www.coingecko.com/en/api  ->  Demo-Schluessel anlegen
COINGECKO_API_KEY=

# --- Twelve Data (Gratistarif: 800 Abrufe/Tag, nur private Nutzung) ---------
# https://twelvedata.com  ->  kostenlos registrieren
TWELVEDATA_API_KEY=

# --- EIA, Brent-Spotpreis (kostenlos, Registrierung) -----------------------
EIA_API_KEY=

# --- Betreiberangaben fuer Impressum und Datenschutz -----------------------
LEGAL_OPERATOR="Elias Schüpany"
LEGAL_ADDRESS="El Paraiso Verde 1, Caazapá, Paraguay"
LEGAL_EMAIL="Elias.schuepany@gmail.com"
LEGAL_PURPOSE="Private Informationsseite zu Finanzmärkten. Keine Anlageberatung."

# --- Veroeffentlichung ------------------------------------------------------
# Erst auf true setzen, wenn die Seite oeffentlich erreichbar sein soll.
# Solange false: Suchmaschinen werden ausgeschlossen.
SITE_PUBLIC=false
