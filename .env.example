# =============================================================================
# Finanzwelt-App – Umgebungsvariablen (Beispiel)
# Kopieren nach `.env.local`. Niemals echte Schluessel committen.
# =============================================================================

# -----------------------------------------------------------------------------
# Aktiver Datenanbieter. Solange "demo" gesetzt ist, laeuft die App vollstaendig
# mit synthetischen, als DEMO gekennzeichneten Beispieldaten.
# Moegliche Werte: demo | eodhd | fmp | twelvedata
# -----------------------------------------------------------------------------
DATA_PROVIDER=demo

# --- Kurse, Stammdaten, Fundamentaldaten -------------------------------------
# EOD Historical Data (https://eodhd.com) – Kurse, Fundamentals, EU-Abdeckung
EODHD_API_KEY=
# Financial Modeling Prep (https://financialmodelingprep.com) – Fundamentals, Analystenschaetzungen
FMP_API_KEY=
# Twelve Data (https://twelvedata.com) – Intraday-Kurse, FX, Krypto
TWELVEDATA_API_KEY=

# --- Nachrichten --------------------------------------------------------------
# Marketaux / NewsAPI / Benzinga o. ae. – Lizenz vor Produktivbetrieb pruefen
NEWS_API_KEY=
NEWS_API_BASE_URL=

# --- Politiker- und Investorenoffenlegungen -----------------------------------
# SEC EDGAR verlangt einen aussagekraeftigen User-Agent (Name + E-Mail)
SEC_EDGAR_USER_AGENT="Finanzwelt-App kontakt@example.org"
# Quelle fuer Congressional Financial Disclosures (z. B. eigener Scraper-Service)
DISCLOSURE_API_BASE_URL=
DISCLOSURE_API_KEY=

# --- Datenbank ----------------------------------------------------------------
# PostgreSQL fuer Kurshistorien, Nachrichtenstaende, Portfolios, Watchlists
DATABASE_URL=postgresql://user:passwort@localhost:5432/finanzwelt

# --- Caching / Hintergrundprozesse -------------------------------------------
REDIS_URL=
# Sekunden, die Kursantworten serverseitig zwischengespeichert werden
CACHE_TTL_QUOTES=60
CACHE_TTL_NEWS=120
CACHE_TTL_FUNDAMENTALS=86400

# --- Anzeige ------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/Vienna
NEXT_PUBLIC_APP_NAME=Finanzwelt-App
